{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python -B \"${PLUGIN_ROOT}/hooks/session_start.py\"",
            "commandWindows": "python -B \"${PLUGIN_ROOT}\\hooks\\session_start.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python -B \"${PLUGIN_ROOT}/hooks/session_start.py\" --compact",
            "commandWindows": "python -B \"${PLUGIN_ROOT}\\hooks\\session_start.py\" --compact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
